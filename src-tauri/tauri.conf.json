{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseFlow",
  "version": "0.1.0-beta.1",
  "identifier": "com.pulseflow.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PulseFlow",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' https://www.youtube.com http://www.youtube.com",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' asset: http://asset.localhost data: https://cdn.jsdelivr.net https://fonts.gstatic.com",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https: wss: http: ws:",
        "worker-src": "'self' blob:",
        "frame-src": "https:",
        "object-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' https://www.youtube.com http://www.youtube.com",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' asset: http://asset.localhost data: https://cdn.jsdelivr.net https://fonts.gstatic.com",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https: wss: http: ws: ws://127.0.0.1:1420 ws://localhost:1420",
        "worker-src": "'self' blob:",
        "frame-src": "https:",
        "object-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
