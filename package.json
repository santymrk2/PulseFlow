{
    "name": "pulseflow",
    "version": "1.6.7-beta.1",
    "private": true,
    "description": "PulseFlow: presentación de letras, biblias y medios con engine GPU nativo",
    "repository": "git@github.com:santymrk2/freeshow.git",
    "author": "ChurchApps <support@livecs.org>",
    "license": "GPL-3.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "overrides": {
        "shell-quote": "^1.8.4",
        "tmp": "^0.2.7",
        "tar": "^7.5.20"
    },
    "scripts": {
        "dev": "vite",
        "setup:sidecars": "bun scripts/setup-sidecars.js",
        "dev:tauri": "tauri dev",
        "build": "vite build",
        "build:tauri": "tauri build",
        "preview": "vite preview",
        "tauri": "tauri",
        "---DEVELOPMENT---": "",
        "build:frontend:dev": "NODE_ENV=development vite",
        "---PRODUCTION---": "",
        "build:frontend:prod": "NODE_ENV=production vite build",
        "---CHECKING---": "",
        "test": "bun run test:unit && bun run test:format && bun run test:types && bun run test:budget",
        "test:unit": "vitest run --config config/testing/vitest.config.mts",
        "test:format": "prettier --config config/formatting/.prettierrc.yaml --check src",
        "test:budget": "bun scripts/quality-budget.ts",
        "test:types": "bun scripts/check-types.ts",
        "format:prettier": "prettier --config config/formatting/.prettierrc.yaml --write src",
        "lint": "bun run lint:frontend && bun run lint:styles",
        "lint:frontend": "eslint -c config/linting/eslint.frontend.json --ext .js,.ts src/frontend --fix",
        "lint:styles": "stylelint 'src/frontend/**/*.{css,scss}' --config config/linting/.stylelintrc.json"
    },
    "devDependencies": {
        "@ffprobe-installer/ffprobe": "^2.1.2",
        "@soundtouchjs/audio-worklet": "^1.0.10",
        "@tanstack/pacer": "^0.14.0",
        "@tauri-apps/cli": "^2",
        "@testing-library/dom": "^10",
        "@testing-library/react": "^16",
        "@types/exif": "^0.6.5",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "@vitejs/plugin-react": "^4",
        "babel-plugin-react-compiler": "^1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.13",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.10.2",
        "eslint-plugin-jsdoc": "^39.9.1",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "ffmpeg-static": "^5.3.0",
        "ffprobe-static": "^3.1.0",
        "firebase": "^12.15.0",
        "happy-dom": "^15",
        "linkedom": "^0.18.13",
        "pdfjs-dist": "^5.4.296",
        "prettier": "^3.6.2",
        "qrcode-generator": "^1.5.2",
        "stylelint": "^16.23.1",
        "stylelint-config-html": "^1.1.0",
        "stylelint-use-logical": "^2.1.2",
        "typescript": "^5.6.0",
        "vite": "^5.4.0",
        "vitest": "^2.1.9"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@tauri-apps/api": "^2.12.4",
        "exif": "^0.6.0",
        "json-bible": "^1.1.9",
        "jzz": "^1.9.5",
        "music-metadata": "^7.14.0",
        "react": "^19",
        "react-dom": "^19",
        "uid": "^2.0.2"
    }
}
