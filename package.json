{
    "name": "pulseflow",
    "version": "1.6.7-beta.1",
    "private": true,
    "description": "PulseFlow: presentación de letras, biblias y medios con engine GPU nativo",
    "repository": "git@github.com:santymrk2/freeshow.git",
    "author": "ChurchApps <support@livecs.org>",
    "license": "GPL-3.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "overrides": {
        "shell-quote": "^1.8.4",
        "tmp": "^0.2.7",
        "tar": "^7.5.20"
    },
    "scripts": {
        "dev": "vite",
        "setup:sidecars": "bun scripts/setup-sidecars.js",
        "dev:tauri": "tauri dev",
        "build": "vite build",
        "build:tauri": "tauri build",
        "preview": "vite preview",
        "tauri": "tauri",
        "---DEVELOPMENT---": "",
        "build:frontend:dev": "NODE_ENV=development vite",
        "---PRODUCTION---": "",
        "build:frontend:prod": "NODE_ENV=production vite build",
        "---CHECKING---": "",
        "test": "bun run test:unit && bun run test:format && bun run test:svelte",
        "test:unit": "vitest run --config config/testing/vitest.config.mts",
        "test:format": "prettier --config config/formatting/.prettierrc.yaml --check src",
        "test:svelte": "svelte-check --ignore docs",
        "test:budget": "bun scripts/quality-budget.ts",
        "format:prettier": "prettier --config config/formatting/.prettierrc.yaml --write src",
        "lint": "bun run lint:frontend && bun run lint:svelte && bun run lint:styles",
        "lint:frontend": "eslint -c config/linting/eslint.frontend.json --ext .js,.ts src/frontend --fix",
        "lint:svelte": "eslint -c config/linting/eslint.svelte.js --ext .svelte src/frontend --fix",
        "lint:styles": "stylelint 'src/frontend/**/*.{css,scss,svelte}' --config config/linting/.stylelintrc.json"
    },
